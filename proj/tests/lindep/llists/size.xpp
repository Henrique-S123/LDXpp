type NatL = linunion {$zero:(), $succ:NatL};
type NODE = (linint | LLIST);
type LLIST = linunion { $nil: (), $cons: NODE };
let l0:LLIST = $nil (());
let l1:LLIST = $cons ((4l | l0));
let l2:LLIST = $cons ((7l | l1));
letrec sizecount:LLIST-o>(linint | NatL) {
    lfn l:LLIST =o> {
        match l {
            $nil(m) -> (0l | $zero(m))
            |
            $cons(m) ->
                split (val | rest) = m;
                split (rc | rs) = sizecount(rest);
                (val + rc | $succ(rs))
        }
    }
};
sizecount(l2);;

