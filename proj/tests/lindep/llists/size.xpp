type NatL = linunion {$zero:(), $succ:NatL};
type NODE = (linint | LLIST);
type LLIST = linunion { $nil: (), $cons: NODE };
let l0:LLIST = $nil (());
let l1:LLIST = $cons ((4l | l0));
let l2:LLIST = $cons ((7l | l1));
letrec sizecopy:(l:LLIST)-o>(NatL | cl:LLIST | (l = cl : LLIST)) {
    lfn l:LLIST =o> {
        match l {
            $nil(m) -> ($zero(()) | $nil(m) | refl)
            |
            $cons(m) ->
                split (val | rest) = m;
                split (sn | rest) = sizecopy(rest);
                split (rl | eqrl) = rest;
                leteq e = eqrl;
                let nl = $cons((val | rl));
                ($succ(sn) | nl | refl)
        }
    }
};
sizecopy(l2);;



type NatL = linunion {$zero:(), $succ:NatL};
type NODE = (int | LLIST);
type LLIST = linunion { $nil: (), $cons: NODE };
let l0:LLIST = $nil (());
let l1:LLIST = $cons ((4 | l0));
let l2:LLIST = $cons ((7 | l1));
letrec sizel:LLIST-o>NatL {
    lfn l:LLIST =o> {
        match l {
            $nil(m) -> m; $zero(())
            |
            $cons(n) ->
                split (val | rest) = n;
                $succ(sizel(rest))
        }
    }
};
sizel(l2);;



type NatL = linunion {$zero:(), $succ:NatL};
type NODE = (int | LLIST);
type LLIST = linunion { $nil: (), $cons: NODE };
let l1:LLIST = $cons ((4 | $nil (())));
let l2:LLIST = $cons ((7 | $cons ((4 | $nil (())))));
letrec sizel:LLIST-o>NatL {
    lfn l:LLIST =o> {
        match l {
            $nil(m) -> m; $zero(())
            |
            $cons(n) ->
                split (val | rest) = n;
                $succ(sizel(rest))
        }
    }
};
letrec concat:LLIST-o>LLIST-o>LLIST {
    lfn a:LLIST, b:LLIST =o> {
        match a {
            $nil(m) -> m; b
            |
            $cons(m) ->
                split (val | rest) = m;
                $cons((val | concat(rest)(b)))
        }
    }
};
sizel(concat(l2)(l1));;
