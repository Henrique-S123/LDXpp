letrec concat:(a:LLIST)-o>(b:LLIST)-o>[r:LLIST, (sizel(r) = ladd(sizel(a))(sizel(b)) : NatL)] =
    lfn a:LLIST, b:LLIST =o> {
        match a {
            $nil(m) -> m; [b, refl]
            |
            $cons(m) ->
                let [val, rest] = m;
                let [rl, eqrl] = concat(rest)(b);
                let nl = $cons([val, rl]);
                [nl, hyp]
        }
    };
let [res, eq] = concat(l2)(l1);
sizel(res);;
