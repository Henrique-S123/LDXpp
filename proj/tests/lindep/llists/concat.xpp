type NODE = (linint | LLIST);
type LLIST = linunion { $nil: (), $cons: NODE };
let l1:LLIST = $cons ((4l | $nil (())));
let l2:LLIST = $cons ((7l | $nil (())));
letrec concat:LLIST-o>LLIST-o>LLIST {
    lfn a:LLIST, b:LLIST =o> {
        match a {
            $nil(m) -> m; b
            |
            $cons(m) ->
                split (val | rest) = m;
                $cons((val | concat(rest)(b)))
        }
    }
};
concat(l2)(l1);;



type NatL = linunion {$zero:(), $succ:NatL};
letrec ladd:NatL-o>NatL-o>NatL {
    lfn a:NatL, b:NatL =o> {
        match a {
            $zero(m) -> m; b
            |
            $succ(m) -> $succ(ladd(m)(b))
        }
    }
};
type NODE = (int | LLIST);
type LLIST = linunion { $nil: (), $cons: NODE };
let l1:LLIST = $cons ((4 | $nil (())));
let l2:LLIST = $cons ((7 | $cons ((4 | $nil (())))));
letrec sizel:LLIST-o>NatL {
    lfn l:LLIST =o> {
        match l {
            $nil(m) -> m; $zero(())
            |
            $cons(n) ->
                split (val | rest) = n;
                $succ(sizel(rest))
        }
    }
};
letrec concat:(a:LLIST)-o>(b:LLIST)-o>(r:LLIST | (sizel(r) = ladd(sizel(a))(sizel(b)) : NatL)) {
    lfn a:LLIST, b:LLIST =o> {
        match a {
            $nil(m) -> m; (b | refl)
            |
            $cons(m) ->
                split (val | rest) = m;
                split (rl | eqrl) = concat(rest)(b);
                let nl = $cons((val | rl));
                (nl | refl)
        }
    }
};
split (res | eq) = concat(l2)(l1);
sizel(res);;



type NatL = linunion {$zero:(), $succ:NatL};
letrec ladd:NatL-o>NatL-o>NatL {
    lfn a:NatL, b:NatL =o> {
        match a {
            $zero(m) -> m; b
            |
            $succ(m) -> $succ(ladd(m)(b))
        }
    }
};
type NODE = (int | LLIST);
type LLIST = linunion { $nil: (), $cons: NODE };
let l1:LLIST = $cons ((4 | $nil (())));
let l2:LLIST = $cons ((7 | $cons ((4 | $nil (())))));
letrec sizel:LLIST-o>NatL {
    lfn l:LLIST =o> {
        match l {
            $nil(m) -> m; $zero(())
            |
            $cons(n) ->
                split (val | rest) = n;
                $succ(sizel(rest))
        }
    }
};
letrec concat:(a:LLIST)-o>(b:LLIST)-o>(r:LLIST | (sizel(r) = ladd(sizel(a))(sizel(b)) : NatL)) {
    lfn a:LLIST, b:LLIST =o> {
        match a {
            $nil(m) -> m; (b | refl)
            |
            $cons(m) ->
                split (val | rest) = m;
                split (rl | eqrl) = concat(rest)(b);
                let nl = $cons((val | rl));
                (nl | hyp)
        }
    }
};
split (res | eq) = concat(l2)(l1);
sizel(res);;
