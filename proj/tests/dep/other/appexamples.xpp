type igt3 = (x:int, ((x>3)=true:bool));
let p:igt3 = (5, refl); p;;

type igt3 = (x:int, ((x>3)=true:bool));
let p:igt3 = (5, refl); snd(p);;

type igt3 = (x:int, ((x>3)=true:bool));
let p:igt3 = (4, refl); p;;

type igt3 = (x:int, ((x>3)=true:bool));
let p:igt3 = (2, refl); p;;



type Pos = (x:int, ((x>0)=true:bool));
let port:Pos = (8080, refl);
let retries:Pos = (3, refl);
fst(port) + fst(retries);;



type Percent = (x:int, ((0<=x && x<=100)=true:bool));
let tax:Percent = (21, refl); tax;;

type Percent = (x:int, ((0<=x && x<=100)=true:bool));
let bad:Percent = (150, refl); bad;;



let dup:(x:int)->(y:int, (y = x + x : int)) =
    fn x:int => { (x + x, refl) }
; dup(3);;

let dup:(x:int)->(y:int, (y = x + x : int)) =
    fn x:int => { (x + x, refl) }
; snd(dup(3));;

let dup:(x:int)->(y:int, (y = x + x : int)) =
    fn x:int => { (x + x, refl) }
; split (val, eq) = dup(3); val;;

let dup:(x:int)->(y:int, (y = x + x : int)) =
    fn x:int => { (x + x, refl) }
; split (val, eq) = dup(3); eq;;
